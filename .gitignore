# Build output. `src/**/*.ts` is the authored source of truth; everything here is
# regenerated by `npm run build` (scripts/project-ts.ts) and must never be hand-edited.
dist/
packages/*/dist/
apps/*/dist/

# Generated at install time by `npm install` or `npm run setup`.
node_modules/

# Verification artefacts: screenshots, dxc output, harness pages, driver logs.
dist/verify/
*.dxil
*.log
__pycache__/
.pytest_cache/
*.pyc
.env
.env.*
!.env.example

# Editor / OS noise.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
.DS_Store

# The example document is GENERATED from packages/ir/src/examples/liquidMetal.ts by
# `npm run build:demo`, but it is deliberately checked in so that a fresh clone can run
# `ai4shader emit examples/…` with no build step. Do not add it here.
